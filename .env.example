# Nach `.env` kopieren. Die drei leeren Pflicht-Secrets vor dem ersten
# `docker compose up` mit unabhängigen, URL-sicheren Werten befüllen, z. B.
# jeweils mit `openssl rand -hex 32`. `.env` niemals committen.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
AEGIS_API_PASSWORD=

POSTGRES_USER=aegis
POSTGRES_DB=aegis
AEGIS_API_USERNAME=aegis

# Veröffentlichte Ports bleiben standardmäßig ausschließlich lokal erreichbar.
AEGIS_BIND_ADDRESS=127.0.0.1
AEGIS_HTTP_PORT=8000
AEGIS_POSTGRES_PORT=5432
AEGIS_REDIS_PORT=6379
LOG_LEVEL=INFO

# Optional: abweichende Dashboard-Adresse für `aeris` (z.B. TLS-Reverse-Proxy).
# AERIS_DASHBOARD_URL=https://aegis.example.com/

# Pfad zum Scope-Verzeichnis. Der npm-Launcher setzt hier automatisch sein
# persistentes Konfigurationsverzeichnis; im Repository gilt ../config.
AERIS_CONFIG_DIR=../config

# Host-Agent: HOST_LOG_DIR wird read-only nach /host/var/log gemountet.
# Debian/Ubuntu: auth.log; RHEL/Fedora: secure.
HOST_LOG_DIR=/var/log
HOST_AGENT_LOG_PATHS=/host/var/log/auth.log
HOST_AGENT_HOSTNAME=monitored-host
HOST_AGENT_SNAPSHOT_INTERVAL_SECONDS=15
HOST_AGENT_REDIS_HOST=127.0.0.1

# Ingestion: Wiederaufnahme hängender Redis-Nachrichten und Dead-letter-Grenze.
INGESTION_PENDING_IDLE_MS=60000
INGESTION_MAX_DELIVERY_ATTEMPTS=5
INGESTION_RECOVERY_BATCH_SIZE=50
INGESTION_RECOVERY_INTERVAL_SECONDS=30
INGESTION_ERROR_BACKOFF_SECONDS=5
INGESTION_DLQ_MAXLEN=10000

# Detection-Tuning
DETECTION_BRUTE_FORCE_THRESHOLD=3
DETECTION_BRUTE_FORCE_WINDOW_MINUTES=5
DETECTION_BRUTE_FORCE_COOLDOWN_MINUTES=15
DETECTION_KEYWORD_COOLDOWN_MINUTES=15
ANOMALY_WINDOW_SECONDS=60
ANOMALY_BASELINE_WINDOWS=10
ANOMALY_MIN_COUNT=5
ANOMALY_Z_THRESHOLD=3.0
ANOMALY_COOLDOWN_MINUTES=15

# Alerting — einen Kanal leer lassen, um ihn zu deaktivieren.
NOTIFY_SEVERITY_THRESHOLD=70
NOTIFY_WEBHOOK_URL=
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=aegis@localhost
NOTIFY_SMTP_HOST=
NOTIFY_SMTP_PORT=587
NOTIFY_SMTP_USER=
NOTIFY_SMTP_PASSWORD=
NOTIFY_MAX_ATTEMPTS=5
NOTIFY_RETRY_BASE_SECONDS=30
NOTIFY_RETRY_MAX_SECONDS=3600
NOTIFY_WORKER_POLL_SECONDS=5
NOTIFY_WORKER_BATCH_SIZE=50

# Globale Aufbewahrung persistierter Events.
EVENT_RETENTION_DAYS=90
EVENT_RETENTION_BATCH_SIZE=1000
MAINTENANCE_INTERVAL_SECONDS=86400

# Nur für Prozesse außerhalb von Compose setzen (Passwörter URL-kodieren):
# DATABASE_URL=postgresql+psycopg://aegis:<password>@127.0.0.1:5432/aegis
# REDIS_URL=redis://:<password>@127.0.0.1:6379/0
# API_USERNAME=aegis
# API_PASSWORD=<mindestens-16-zeichen; kann AEGIS_API_PASSWORD entsprechen>
# SCOPE_FILE=config/scope.yaml
