# Kopieren nach .env und bei Bedarf anpassen (lokale Entwicklung außerhalb von Docker Compose).
DATABASE_URL=postgresql+psycopg://aegis:aegis@localhost:5432/aegis
REDIS_URL=redis://localhost:6379/0
LOG_LEVEL=INFO
SCOPE_FILE=config/scope.yaml

# Host-Agent (Phase 1)
HOST_AGENT_HOSTNAME=localhost
HOST_AGENT_LOG_PATHS=logs/auth.log
HOST_AGENT_SNAPSHOT_INTERVAL_SECONDS=15

# Alerting (Phase 1) — leer lassen, um Kanal zu deaktivieren
NOTIFY_SEVERITY_THRESHOLD=70
NOTIFY_WEBHOOK_URL=
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=aegis@localhost
NOTIFY_SMTP_HOST=
NOTIFY_SMTP_PORT=587
NOTIFY_SMTP_USER=
NOTIFY_SMTP_PASSWORD=
